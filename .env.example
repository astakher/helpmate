# HelpMate configuration. Copy to .env and edit. Every seam defaults to its fake,
# so the app runs end to end with no GPU, no database and no accounts.

# --- Adapter selection (the plug-in switches) ---
HELPMATE_AGENT=scripted        # scripted | loop       (A: agent loop + policy engine)
HELPMATE_LLM=fake              # fake | ollama         (A)
HELPMATE_REPO=memory           # memory | postgres     (B)
HELPMATE_SCHEDULER=dev         # dev | pg (durable queue; needs HELPMATE_REPO=postgres)  (B)
HELPMATE_NOTIFIER=log          # log | webpush         (C)
HELPMATE_STT=fake              # fake | http           (C: speech service)
HELPMATE_TTS=fake              # fake | http           (C: speech service)
HELPMATE_AUTH=dev              # dev | totp            (B)
HELPMATE_MAIL=fake             # fake | gmail          (B)
HELPMATE_CALENDAR=fake         # fake | google         (B)

# --- Gmail + Google Calendar: put the Desktop OAuth client at data/google_client_secret.json, ---
# --- then connect once: cd backend; uv run python ../scripts/google_auth.py (docs/setup-windows.md) ---
HELPMATE_DAY_START_HOUR=9      # find_free_time only offers time between these local hours
HELPMATE_DAY_END_HOUR=18

# --- Login (HELPMATE_AUTH=totp): password hash from `cd backend; uv run python ../scripts/set_password.py` ---
HELPMATE_OWNER_USERNAME=owner
HELPMATE_OWNER_PASSWORD_HASH=

# --- Core ---
HELPMATE_TIMEZONE=America/Toronto
HELPMATE_SCHEDULER_TICK_SECONDS=5

# --- Ollama (inference plane, runs natively on the host) ---
HELPMATE_OLLAMA_URL=http://127.0.0.1:11434
HELPMATE_OLLAMA_MODEL=llama3.2:3b
HELPMATE_OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Speech service (services/speech) ---
HELPMATE_SPEECH_URL=http://127.0.0.1:8001
# real: run ./scripts/get_models.ps1 once, then set HELPMATE_STT=http and HELPMATE_TTS=http too
SPEECH_ENGINE=fake             # fake | real
SPEECH_WHISPER_MODEL=base      # tiny | base | small (multilingual); *.en = English only
# empty = auto-detect language; "en" is ~0.5 s faster per clip but English only
SPEECH_WHISPER_LANGUAGE=
SPEECH_CPU_THREADS=4
SPEECH_KOKORO_VOICE=af_heart

# --- Postgres + SeaweedFS (infra/docker-compose.yml) ---
POSTGRES_USER=helpmate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=helpmate
HELPMATE_DATABASE_URL=postgresql://helpmate:change-me@127.0.0.1:5432/helpmate
S3_ACCESS_KEY=helpmate
S3_SECRET_KEY=change-me-too
S3_BUCKET=helpmate
HELPMATE_S3_ENDPOINT=http://127.0.0.1:8333

# --- Web Push (generate once, same keys on every host: cd backend; uv run python ../scripts/gen_vapid.py --write) ---
HELPMATE_VAPID_PUBLIC_KEY=
HELPMATE_VAPID_PRIVATE_KEY=
HELPMATE_VAPID_SUBJECT=mailto:you@example.com
HELPMATE_PUSH_TTL_SECONDS=3600
