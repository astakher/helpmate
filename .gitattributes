# Normalize line endings: LF in the repo and working tree (Windows devs + Linux CI/containers)
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webm binary
*.mp4 binary
*.m4a binary
*.wav binary
*.onnx binary
*.bin binary
